# ---- 你自己的真实配置：绝不能进仓库 ----
config.json
deploy/config.json
.env
deploy/.env
# 看门狗的真实告警配置（含 webhook 密钥）。模板是 watchdog.env.example，那个要提交。
deploy/watchdog.env
watchdog.env

# ---- 运行期产物 ----
state_*.json
# 状态文件的 flock 锁文件（`state_*.json.lock`，2026-10-06 起 esports.py 会用它们做
# 跨进程互斥）。它们**不是 .json 结尾**，所以上面那条 `state_*.json` 挡不住 ——
# 开发机跑一次 `--check` 就会留下一个空锁文件。两条都要有。
state_*.lock
selftest_result.txt
# 世界排名（HLTV）的抓取缓存：只是排名的副本，随时可重建，没必要进仓库
rank_cache.json
rank_cache.json.tmp
# 队标缓存：文件名是 sha256(url) 前 16 位，随时可从赛程页重建，没必要进仓库
#（打包时会自动跳过：pack_deploy.py 只收 deploy/ 下的**文件**，目录不进包）
deploy/logo_cache/
# 生成 card_font.otf 用的**源字体**（Noto Sans SC，8 MB）。产物已入库，源文件不要 ——
# 重跑 deploy/make_card_font.py 会自动重新下载。pack_deploy.py 的 SKIP_NAMES 里也钉着，
# 因为它对 deploy/ 是「全收」，只靠一条守卫不够。
deploy/NotoSansSC-Regular.otf
# 登录二维码：本质是一次性登录凭据，生成一次就作废。绝不能进仓库。
qr.png
qr.svg
qrcode.png
qrcode.b64
__pycache__/
*.pyc
*.pyo

# ---- 打包产物 ----
deploy.zip

# ---- 项目内部交接文档（不是给外人看的）----
HANDOFF.md
