[Unit]
Description=斗鱼开播提醒 · 单次检查（由 douyu-watch.timer 每分钟拉起）
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot

# state_YOUR_ROOM_ID.json 是相对 watch.py 所在目录落盘的（脚本里用 __file__ 定位），
# 所以 WorkingDirectory 不影响状态读写；留着是为了排错时路径直观。
WorkingDirectory=/opt/douyu-live-notify

ExecStart=/usr/bin/python3 /opt/douyu-live-notify/watch.py --tick

# 每次调用只跑几秒，给足余量；卡住也别无限等
TimeoutStartSec=120

# 让 systemd 创建 /var/log/douyu-watch。
# ⚠️ 实测 Ubuntu 24.04 上它不足以兜底：目录不存在时，下面 append: 那两行会在
#    「打开输出文件」阶段直接失败（报 209/STDOUT），日志里只有
#    "Failed at step STDOUT ...: No such file or directory"，看不出跟日志目录有关。
#    所以真正的兜底是 /etc/tmpfiles.d/douyu-watch.conf（开机就建目录），
#    install-watch.sh 会一并装好。手动重建：
#      systemd-tmpfiles --create /etc/tmpfiles.d/douyu-watch.conf
LogsDirectory=douyu-watch

# 输出进独立日志。这一行里带 loop= 字段，
# 是事后复验「轮播 vs 真人直播」的唯一依据，别删。
StandardOutput=append:/var/log/douyu-watch/tick.log
StandardError=append:/var/log/douyu-watch/tick.log

# 最小权限
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
