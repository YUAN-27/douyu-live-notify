# NapCat 的运行参数。docker compose 会自动读取同目录下的 .env。
# 用法：复制成本目录下的 .env，再填上你自己的 token。
#   cp .env.example .env
# 然后连同 docker-compose.yml 一起放到服务器上的 /opt/napcat/

# WebUI（6099 端口）的登录密码。**这个必须换掉**，别留占位符，也别留空。
# 生成：openssl rand -hex 16
WEBUI_TOKEN=YOUR_WEBUI_TOKEN

# 容器以什么身份运行。填 `id -u` / `id -g` 的结果即可。
# 填 0 0 就是以 root 跑（省事，但权限更大）。
NAPCAT_UID=0
NAPCAT_GID=0

# NapCat 容器的内存上限。
# ⚠️ 必须 **≤ 宿主机可用内存**，否则这道「内存失控时保护同机其他服务」的安全网失效。
# 取法：宿主机可用内存（`free -h` 的 available）× 0.8
#   可用 800MB → 700m ／ 可用 1.5GB → 1200m ／ 可用 3GB → 2000m
# 机器内存充裕（≥4GB）且没有别的服务，可以不管这一项。
# 之后照实测峰值调：docker stats napcat --no-stream
NAPCAT_MEM_LIMIT=700m
