# 斗鱼开播提醒 · 看门狗配置
#
# 安装位置：/etc/default/douyu-watchdog（systemd 单元用 EnvironmentFile 读它）
# 安装方式：install-watch.sh 会自动装一份；若已存在则**绝不覆盖**。
#   cp watchdog.env.example /etc/default/douyu-watchdog
#   chmod 600 /etc/default/douyu-watchdog      # 里面有 webhook 密钥，别让别的用户读到
#   systemctl restart douyu-watchdog.timer     # 改完要重启定时器才生效
#
# 语法：KEY=value，**不要**写 export、不要加引号、不要留行尾空格。
# 下面所有项都可以不填 —— 不填就是括号里的默认值。

# ─────────────────────────────────────────────────────────────────────────
# 一、告警发到哪（这是唯一需要你花 5 分钟决定的事）
# ─────────────────────────────────────────────────────────────────────────
#
# 为什么重要：NapCat 掉线时，它自己发不出消息 —— 所以告警必须走一条
#             **不经过 NapCat** 的通道，否则「掉线告警」等于没说。
#
# 三个可选通道，优先级从高到低（配了几个就同时用几个）：
#
#   1. ALERT_ONEBOT_PRIVATE —— 用 NapCat 私聊你自己。零成本、即时，
#      但它依赖 NapCat 在线，所以只能覆盖「watch.py 停摆」这类故障，
#      覆盖不了「NapCat 掉线」。
#   2. ALERT_WEBHOOK —— 通用 webhook。**这是唯一在 NapCat 挂掉时还能
#      到达你的通道，强烈建议至少配这一个。** 见下面推荐的几家。
#   3. ALERT_EMAIL —— 走本机 msmtp/sendmail，需要服务器上有可用的发信配置。
#
# 推荐（按省事程度）：
#   ・Bark（iOS，装个 App 就有 URL）      ：ALERT_WEBHOOK_KIND=bark
#   ・Server酱（微信推送，扫码拿 key）    ：ALERT_WEBHOOK_KIND=serverchan
#   ・飞书/钉钉/企业微信群机器人（把机器人的 webhook 地址贴进来即可）
#                                         ：ALERT_WEBHOOK_KIND=feishu / dingtalk / wecom
#   ・Telegram Bot                        ：ALERT_WEBHOOK_KIND=telegram（另需 ALERT_TG_CHAT_ID）
#
# 无论配不配，告警都会**无条件**写一行到 /var/lib/douyu-watchdog/alerts.log，
# 所以不配也不会丢，只是没人叫醒你 —— 那句「没有配置任何独立于 NapCat 的
# 告警通道」的提示是故意的，不假装成功。

# 你的主 QQ 号（不是机器人小号）。填了就用私聊发告警到你自己。
# 刻意不给机器人私聊发到**群**：掉线告警发群里会打扰一堆人，没意义。
ALERT_ONEBOT_PRIVATE=

# 通用 webhook 地址。填了就多一条独立于 NapCat 的通道。
ALERT_WEBHOOK=

# webhook 类型：generic / serverchan / bark / telegram / dingtalk / feishu / wecom
# generic 会发 {"title":..,"text":..,"level":"alert","host":..,"time":..} 这种通用 JSON。
ALERT_WEBHOOK_KIND=generic

# 仅 telegram 需要：你的 chat_id（可以先给 bot 发一条消息，再访问
#   https://api.telegram.org/bot<token>/getUpdates 里拿）
ALERT_TG_CHAT_ID=

# 邮件通道（可选）。需要本机已装好 msmtp 或 sendmail，本脚本不替你装。
ALERT_EMAIL=
# 发件人地址，不填则用 douyu-watchdog@<主机名>
# ALERT_EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────
# 二、判定阈值（不知道就别动）
# ─────────────────────────────────────────────────────────────────────────

# 心跳陈旧多久算「watch.py 没在跑」，单位秒。默认 420（7 分钟）。
# watch.py 每分钟一跳，连着 7 跳没来才判定，不会误报。
# ⚠️ 心跳日志里只有时间没有日期，所以新鲜度看的是日志文件修改时间，不是解析出来那个时刻。
STALE_SECONDS=420

# 心跳序号连续几轮不前进算「卡死」。默认 3（看门狗每 2 分钟一轮 ≈ 6 分钟）。
# 和「没在跑」不是一回事：卡死 = 日志在写、但每轮都在抛错（例如斗鱼接口挂了）。
STUCK_ROUNDS=3

# 连续几轮发现 NapCat 不通才动手。默认 3（≈6 分钟），避免把它自己的慢启动当成故障。
FAIL_THRESHOLD=3

# ─────────────────────────────────────────────────────────────────────────
# 三、自愈策略
# ─────────────────────────────────────────────────────────────────────────

# 1=允许自动 docker restart napcat，0=只告警不动手。
# 敢开自动重启的前提是「重启能免扫码自动登录」—— 那一步必须已经验收通过
# （见 DEPLOY.md「重启免扫码验收」）。没验过就先设 0。
AUTO_RESTART=1

# 两次自动重启之间至少间隔多少秒，默认 900（15 分钟）。防止重启风暴。
RESTART_COOLDOWN=900

# 一天最多自动重启几次，默认 6。到顶就停手转人工告警。
# 为什么要有这个上限：反复重启通常是内存不足或配置错误，
# 继续重启只会让 NapCat 和你的个人网页一起雪崩。
MAX_RESTARTS_PER_DAY=6

# ─────────────────────────────────────────────────────────────────────────
# 四、告警频率
# ─────────────────────────────────────────────────────────────────────────

# 同一个问题最多多久提醒一次（秒），默认 3600。同一故障不会每 2 分钟刷你一次。
ALERT_REPEAT_SECONDS=3600

# 每天这个时刻之后，如果一切正常，就发一条「一切正常」。
# 这是**沉默即出事**的兜底：哪天你没收到这条，说明机器或看门狗自己挂了。
# 留空 = 不发。建议填你每天一定会看手机的时间，例如 20:00。
DAILY_OK_AT=

# ─────────────────────────────────────────────────────────────────────────
# 五、路径与对象（一般不用改）
# ─────────────────────────────────────────────────────────────────────────

# APP_DIR=/opt/douyu-live-notify
# TICK_LOG=/var/log/douyu-watch/tick.log
# STATE_DIR=/var/lib/douyu-watchdog
# NAPCAT_CONTAINER=napcat
# CONFIG=/opt/douyu-live-notify/config.json
# HTTP_TIMEOUT=10
# CMD_TIMEOUT=60

# OneBot 地址与 token 默认从 config.json 里读，不用在这里重复一遍。
# 万一你想指向另一个实例再往下填：
# ONEBOT_BASE=http://127.0.0.1:3000
# ONEBOT_TOKEN=
